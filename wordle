import tkinter as tk
from tkinter import messagebox

ANSWER = "WORLD"
MAX_TRIES = 6
current_try = 0

root = tk.Tk()
root.title("Wordle - Tkinter")
root.geometry("500x650")
root.resizable(False, False)

# ------------------ 標題 ------------------
tk.Label(root, text="WORDLE", font=("Arial", 24, "bold")).pack(pady=10)
tk.Label(root, text="Guess the Wordle in 6 tries\nAnswer: WORLD",
         font=("Arial", 12)).pack()

# ------------------ 棋盤 ------------------
board_frame = tk.Frame(root)
board_frame.pack(pady=20)

labels = []
for r in range(MAX_TRIES):
    row = []
    for c in range(5):
        lbl = tk.Label(board_frame, text=" ",
                       font=("Arial", 18, "bold"),
                       width=4, height=2,
                       relief="solid", bg="white")
        lbl.grid(row=r, column=c, padx=5, pady=5)
        row.append(lbl)
    labels.append(row)

# ------------------ 輸入框 ------------------
entry = tk.Entry(root, font=("Arial", 18), justify="center")
entry.pack(pady=10)
entry.focus()

# ------------------ 判斷 ------------------
def check_word():
    global current_try
    guess = entry.get().upper()

    if len(guess) != 5 or not guess.isalpha():
        messagebox.showwarning("錯誤", "請輸入 5 個英文字母")
        return

    entry.delete(0, tk.END)

    for i in range(5):
        ch = guess[i]
        lbl = labels[current_try][i]
        lbl.config(text=ch)

        if ch == ANSWER[i]:
            lbl.config(bg="green", fg="white")
        elif ch in ANSWER:
            lbl.config(bg="gold", fg="black")
        else:
            lbl.config(bg="light gray", fg="black")

    if guess == ANSWER:
        messagebox.showinfo("🎉 恭喜", "你猜對了！")
        root.destroy()
        return

    current_try += 1
    if current_try == MAX_TRIES:
        messagebox.showinfo("😢 結束", f"答案是 {ANSWER}")
        root.destroy()

# ------------------ 虛擬鍵盤 ------------------
keyboard_frame = tk.Frame(root)
keyboard_frame.pack(pady=10)

keys = [
    "QWERTYUIOP",
    "ASDFGHJKL",
    "ZXCVBNM"
]

def press_key(k):
    if k == "ENTER":
        check_word()
    elif k == "←":
        entry.delete(len(entry.get()) - 1, tk.END)
    else:
        if len(entry.get()) < 5:
            entry.insert(tk.END, k)

for row in keys:
    row_frame = tk.Frame(keyboard_frame)
    row_frame.pack()
    for ch in row:
        tk.Button(row_frame, text=ch, width=4, height=2,
                  font=("Arial", 12),
                  command=lambda c=ch: press_key(c)).pack(side="left", padx=2, pady=2)

# Enter / Backspace
control_frame = tk.Frame(root)
control_frame.pack(pady=5)

tk.Button(control_frame, text="ENTER", width=10, height=2,
          font=("Arial", 12),
          command=lambda: press_key("ENTER")).pack(side="left", padx=5)

tk.Button(control_frame, text="←", width=6, height=2,
          font=("Arial", 12),
          command=lambda: press_key("←")).pack(side="left", padx=5)

# 鍵盤 Enter 也可用
root.bind("<Return>", lambda e: check_word())

root.mainloop()
