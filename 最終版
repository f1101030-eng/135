import tkinter as tk
from tkinter import messagebox

class WordleGame:
    def __init__(self, root):
        self.root = root
        self.root.title("Python Wordle")
        self.root.geometry("400x650") # 稍微調高高度

        # --- 遊戲設定 ---
        self.target_word = "WORLD"
        self.attempts = 0
        self.max_attempts = 6
        self.current_guess = []

        # --- 顏色設定 ---
        self.color_correct = "#6aaa64" # 綠色
        self.color_present = "#c9b458" # 黃色
        self.color_absent = "#787c7e"  # 灰色
        self.color_bg = "#ffffff"

        self.setup_ui()
        
        # 綁定鍵盤事件
        self.root.bind("<Key>", self.handle_keypress)

        # --- 關鍵修改：啟動時先顯示規則視窗 ---
        # 使用 after(100, ...) 確保主視窗載入後再跳出規則
        self.root.after(100, self.show_rules)

    def show_rules(self):
        """ 建立初始浮動規則視窗 """
        # 建立一個 Toplevel 視窗 (浮動視窗)
        rule_win = tk.Toplevel(self.root)
        rule_win.title("遊戲規則")
        rule_win.geometry("350x450")
        
        # 強制該視窗在最上層，且在關閉前無法操作主視窗 (Modal)
        rule_win.transient(self.root)
        rule_win.grab_set()

        # 規則內容文字
        rules_text = (
            "【遊戲規則】\n\n"
            "在 6 次嘗試內猜出 Wordle。\n"
            "每次嘗試必須輸入一個五字母的有效單字。\n\n"
            "輸入後，方塊顏色會改變，顯示接近程度：\n\n"
            "● 綠色 (W)：字母在單字中且位置正確。\n"
            "● 黃色 (I)：字母在單字中但位置不正確。\n"
            "● 灰色 (U)：字母不在單字中任何位置。\n\n"
            "答案提示：WORLD"
        )

        # 建立顯示文字的 Label
        tk.Label(rule_win, text=rules_text, font=("Arial", 11), justify="left", padx=20, pady=20).pack()

        # 建立「開始遊戲」按鈕，點擊後關閉此視窗
        start_btn = tk.Button(rule_win, text="開始遊戲", command=rule_win.destroy, 
                              font=("Arial", 12, "bold"), bg="#6aaa64", fg="white", padx=20, pady=10)
        start_btn.pack(pady=10)

    def setup_ui(self):
        """ 建立遊戲主格線介面 """
        self.cells = []
        self.grid_frame = tk.Frame(self.root)
        self.grid_frame.pack(pady=20)

        for r in range(self.max_attempts):
            row_cells = []
            for c in range(5):
                cell = tk.Label(
                    self.grid_frame, text="", font=("Arial", 24, "bold"),
                    width=2, height=1, relief="solid", borderwidth=2, bg=self.color_bg
                )
                cell.grid(row=r, column=c, padx=3, pady=3)
                row_cells.append(cell)
            self.cells.append(row_cells)

    def handle_keypress(self, event):
        """ 處理玩家鍵盤輸入 """
        key = event.char.upper()
        
        # 處理字母輸入 (只允許 A-Z)
        if key.isalpha() and len(key) == 1 and len(self.current_guess) < 5:
            self.current_guess.append(key)
            self.update_grid()

        # 處理退格
        elif event.keysym == "BackSpace" and len(self.current_guess) > 0:
            self.current_guess.pop()
            self.update_grid()

        # 處理送出答案
        elif event.keysym == "Return" and len(self.current_guess) == 5:
            self.submit_guess()

    def update_grid(self):
        """ 同步顯示目前輸入的字母 """
        row = self.cells[self.attempts]
        for i in range(5):
            if i < len(self.current_guess):
                row[i].config(text=self.current_guess[i])
            else:
                row[i].config(text="")

    def submit_guess(self):
        """ 提交並比對單字 """
        guess_str = "".join(self.current_guess)
        result_colors = self.check_word(guess_str)

        # 更新背景顏色
        for i in range(5):
            self.cells[self.attempts][i].config(bg=result_colors[i], fg="white")

        if guess_str == self.target_word:
            messagebox.showinfo("恭喜", "恭喜你！猜對了！")
            self.root.destroy()
        elif self.attempts == self.max_attempts - 1:
            messagebox.showinfo("遊戲結束", f"很遺憾，答案是: {self.target_word}")
            self.root.destroy()
        else:
            self.attempts += 1
            self.current_guess = []

    def check_word(self, guess):
        """ 顏色判斷邏輯 """
        result = [self.color_absent] * 5
        target_list = list(self.target_word)
        guess_list = list(guess)

        # 優先判斷綠色
        for i in range(5):
            if guess_list[i] == target_list[i]:
                result[i] = self.color_correct
                target_list[i] = None
                guess_list[i] = None

        # 再判斷黃色
        for i in range(5):
            if guess_list[i] is not None and guess_list[i] in target_list:
                result[i] = self.color_present
                target_list[target_list.index(guess_list[i])] = None

        return result

if __name__ == "__main__":
    root = tk.Tk()
    game = WordleGame(root)
    root.mainloop()
